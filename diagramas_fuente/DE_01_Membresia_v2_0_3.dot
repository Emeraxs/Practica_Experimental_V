digraph MembershipState {
  graph [rankdir=LR, label="Máquina de estados - Membresía", labelloc=t, fontsize=18, fontname="Helvetica-Bold", pad=0.25];
  node [shape=circle, fontname="Helvetica", fontsize=10, width=1.25, fixedsize=true];
  edge [fontname="Helvetica", fontsize=8];
  inicio [shape=point]; activa [label="ACTIVA"]; porv [label="POR\nVENCER"]; venc [label="VENCIDA"]; suspend [label="SUSPENDIDA"];
  inicio -> activa [label="activar / pago confirmado"];
  activa -> porv [label="<= 3 días al vencimiento"];
  porv -> venc [label="fecha > vencimiento"];
  activa -> suspend [label="suspensión autorizada"];
  suspend -> activa [label="reactivar"];
  venc -> activa [label="renovar / nuevo periodo"];
  porv -> activa [label="renovar"];
}
